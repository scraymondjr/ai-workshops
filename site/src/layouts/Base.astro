---
import "@fontsource/fraunces/600.css";
import "@fontsource/outfit/400.css";
import "@fontsource/outfit/500.css";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/global.css";

const { title, description } = Astro.props as { title: string; description?: string };
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={`${base}favicon.svg`} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={base}>
        <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
          <rect width="32" height="32" rx="8" fill="#0e6a4a" />
          <path d="M16 25c0-8 6-12 10-14-4 1-8 0-10-4 0 6-2 9-6 11 3 1 5 3 6 7z" fill="#f3eee4" />
        </svg>
        Fernhill workshops
      </a>
      <nav class="nav">
        <a href={`${base}workshops/data-engineering/`}>Metrics, not SQL</a>
        <a href={`${base}workshops/context-engineering/`}>Context</a>
        <a href={`${base}workshops/data-engineering/game-day/`}>Game day</a>
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        Fernhill is a fictional field-service SaaS. Local-first, open models, $0 by default.
        Solutions are not on this branch.
      </div>
    </footer>
    <script>
      const nodes = document.querySelectorAll(".mermaid");
      if (nodes.length) {
        const mermaid = (await import("mermaid")).default;
        mermaid.initialize({ startOnLoad: false, theme: "neutral", securityLevel: "loose", fontFamily: "Outfit, sans-serif" });
        await mermaid.run({ nodes });
      }
    </script>
  </body>
</html>
